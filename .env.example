# ==============================================================
# HAATZA E-COMMERCE FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Note: Never place sensitive private keys or secrets in frontend code.
# ==============================================================

# API Base URL for Phase 2 Integration
VITE_API_BASE_URL=https://api.haatza.in/v1

# Mode: mock | api
VITE_DATA_SOURCE_MODE=mock

# Dark-Store Delivery Radius Lookup Key (Mock or Public Provider)
VITE_GEO_LOOKUP_KEY=demo_public_geo_key

# Payment Gateway Public Key (Razorpay / Cashfree client test key)
VITE_PAYMENT_GATEWAY_PUBLIC_KEY=rzp_test_placeholder_key

# Analytics (Optional)
VITE_ANALYTICS_ID=
